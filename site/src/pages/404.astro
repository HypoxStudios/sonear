---
import { t } from "../i18n";
import Base from "../layouts/Base.astro";

const en = t("en").notFound;
const es = t("es").notFound;
---
<Base locale="en" path="/404/" title={t("en").meta.notFoundTitle}>
	<div class="mx-auto max-w-[1100px] px-4 pt-14 sm:px-6 sm:pt-20">
		<p class="font-mono text-sm text-faint">404</p>
		<div class="mt-4 grid gap-10 sm:grid-cols-2">
			<section lang="en">
				<h1 class="text-3xl">{en.title}</h1>
				<p class="mt-3 text-muted">{en.body}</p>
				<p class="copy mt-4"><a href="/">{en.home}</a></p>
			</section>
			<section lang="es">
				<h1 class="text-3xl">{es.title}</h1>
				<p class="mt-3 text-muted">{es.body}</p>
				<p class="copy mt-4"><a href="/es/">{es.home}</a></p>
			</section>
		</div>
	</div>
</Base>

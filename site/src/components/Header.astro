---
import mark from "../../../crates/app/assets/mark.svg";
import { type Locale, localePath, t } from "../i18n";

interface Props {
	locale: Locale;
	switchHref: string;
}

const { locale, switchHref } = Astro.props;
const dict = t(locale);

const links = [
	{ href: `${localePath(locale, "/")}#features`, label: dict.nav.features },
	{ href: localePath(locale, "/setup/"), label: dict.nav.setup },
	{ href: localePath(locale, "/changelog/"), label: dict.nav.changelog },
	{ href: "https://github.com/HypoxStudios/sonear", label: dict.nav.github },
];
const other = locale === "en" ? "es" : "en";
---
<header class="site-header sticky top-0 z-40 border-b border-white/5 bg-bg/70 backdrop-blur-md">
	<div class="mx-auto flex max-w-[1100px] flex-wrap items-center justify-between gap-x-6 gap-y-1 px-4 py-3 sm:px-6">
		<a href={localePath(locale, "/")} class="flex items-center gap-2.5 font-heading text-lg font-semibold tracking-tight">
			<img src={mark.src} width="28" height="28" alt="" class="size-7" />
			Sonear
		</a>
		<nav aria-label={dict.nav.menu} class="order-last flex w-full gap-5 overflow-x-auto text-sm text-muted sm:order-none sm:w-auto sm:gap-6">
			{links.map((link) => (
				<a href={link.href} class="py-1 whitespace-nowrap transition-colors hover:text-ink">{link.label}</a>
			))}
		</nav>
		<div class="flex items-center gap-1 font-mono text-xs" role="group" aria-label={dict.nav.language}>
			<span class="rounded-md bg-raised px-2 py-1 text-ink" aria-current="true">{locale.toUpperCase()}</span>
			<a href={switchHref} hreflang={other} lang={other} class="rounded-md px-2 py-1 text-muted transition-colors hover:text-ink">{other.toUpperCase()}</a>
		</div>
	</div>
</header>

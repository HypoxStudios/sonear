---
import { Image } from "astro:assets";
import { tracks } from "../data/now-playing";

interface Props {
	labels: {
		label: string;
		placeholder: string;
		songs: string;
		commands: string;
		play: string;
		run: string;
		noResults: string;
		playPause: string;
		next: string;
		prev: string;
		lyrics: string;
		mini: string;
	};
}

const { labels } = Astro.props;

const icons: Record<string, string> = {
	playPause:
		'<path d="M6 4.8c0-1.3 1.4-2.1 2.5-1.4l11.6 7.2c1 .6 1 2.1 0 2.8L8.5 20.6c-1.1.7-2.5-.1-2.5-1.4z"/>',
	next: '<polygon points="5 4 15 12 5 20 5 4"/><line x1="19" x2="19" y1="5" y2="19"/>',
	prev: '<polygon points="19 20 9 12 19 4 19 20"/><line x1="5" x2="5" y1="19" y2="5"/>',
	lyrics:
		'<path d="M12 2a3 3 0 0 0-3 3v7a3 3 0 0 0 6 0V5a3 3 0 0 0-3-3Z"/><path d="M19 10v2a7 7 0 0 1-14 0v-2"/><line x1="12" x2="12" y1="19" y2="22"/>',
	mini: '<path d="M21 9V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v10c0 1.1.9 2 2 2h4"/><rect width="10" height="7" x="12" y="13" rx="2"/>',
};

const actions = ["playPause", "next", "prev", "lyrics", "mini"] as const;
---
<div class="palette rounded-panel border border-line bg-surface p-2 shadow-[0_16px_40px_rgb(0_0_0/0.4)]" data-palette>
	<div class="flex items-center gap-3 border-b border-line px-3 pt-2 pb-3">
		<svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="flex-none text-muted" aria-hidden="true"><circle cx="11" cy="11" r="8" /><path d="m21 21-4.3-4.3" /></svg>
		<input
			type="text"
			role="combobox"
			aria-expanded="true"
			aria-controls="pal-list"
			aria-autocomplete="list"
			aria-label={labels.label}
			placeholder={labels.placeholder}
			autocomplete="off"
			autocapitalize="off"
			spellcheck="false"
			data-input
			class="w-full min-w-0 bg-transparent text-base text-ink placeholder:text-faint focus:outline-none"
		/>
	</div>

	<div id="pal-list" role="listbox" aria-label={labels.label} class="max-h-[340px] overflow-y-auto px-1 pt-1" data-list>
		<div role="group" aria-labelledby="pal-g-songs" data-group>
			<p id="pal-g-songs" class="px-2 pt-2 pb-1 text-xs font-medium text-faint">{labels.songs}</p>
			{tracks.map((track, i) => (
				<div id={`pal-opt-song-${i}`} role="option" aria-selected="false" class="pal-opt" data-kind="song" data-i={i} data-text={`${track.title} ${track.artist}`}>
					<Image src={track.cover} alt="" widths={[64, 96]} sizes="32px" format="webp" class="size-8 flex-none rounded-[4px] object-cover" />
					<span class="min-w-0">
						<span class="block truncate text-sm font-medium">{track.title}</span>
						<span class="block truncate text-xs text-muted">{track.artist}</span>
					</span>
					<span class="pal-hint">{labels.play}</span>
				</div>
			))}
		</div>

		<div role="group" aria-labelledby="pal-g-commands" data-group>
			<p id="pal-g-commands" class="px-2 pt-3 pb-1 text-xs font-medium text-faint">{labels.commands}</p>
			{actions.map((action) => (
				<div id={`pal-opt-${action}`} role="option" aria-selected="false" class="pal-opt" data-kind="action" data-action={action} data-text={labels[action]}>
					<span class="grid size-8 flex-none place-items-center text-muted">
						<svg viewBox="0 0 24 24" width="18" height="18" fill={action === "playPause" ? "currentColor" : "none"} stroke={action === "playPause" ? "none" : "currentColor"} stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={icons[action]} />
					</span>
					<span class="min-w-0 truncate text-sm">{labels[action]}</span>
					<span class="pal-hint">{labels.run}</span>
				</div>
			))}
		</div>

		<p class="px-3 py-6 text-center text-sm text-muted" role="status" data-empty-message hidden>{labels.noResults}</p>
	</div>
</div>

<script>
	import "../scripts/palette";
</script>

---
import demo from "../../../../docs/demo.webp";
import { type Locale, localePath, t } from "../../i18n";
import Base from "../../layouts/Base.astro";
import { getReleaseData } from "../../lib/releases";
import Lyrics from "../Lyrics.astro";
import MiniPlayer from "../MiniPlayer.astro";
import NowPlaying from "../NowPlaying.astro";
import Palette from "../Palette.astro";

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const dict = t(locale).home;
const { latest } = await getReleaseData();

const facts =
	latest.version && latest.sizeMb
		? dict.facts.replace("{version}", latest.version).replace("{size}", String(latest.sizeMb))
		: dict.factsFallback;
const privacy = localePath(locale, "/privacy/");
const setup = localePath(locale, "/setup/");
const perfLead = dict.perfLead
	.replace("{idle}", `<span class="perf-num">${dict.perfValues.idle}</span>`)
	.replace("{mem}", `<span class="perf-num">${dict.perfValues.mem}</span>`)
	.replace("{busy}", `<span class="perf-num">${dict.perfValues.busy}</span>`);

const rows = [
	{ ...dict.ctrlk, kind: "palette" },
	{ ...dict.lyrics, kind: "lyrics" },
	{ ...dict.mini, kind: "mini" },
];

const buttonBase =
	"rounded-control px-6 py-3 font-semibold transition-transform duration-150 active:scale-[.98]";
---
<Base locale={locale} path={localePath(locale, "/")}>
	<link slot="head" rel="stylesheet" href="/now-playing.css" />

	<section class="mx-auto grid max-w-[1100px] items-center gap-12 px-4 pt-12 pb-16 sm:px-6 sm:pt-20 lg:grid-cols-[1.05fr_0.95fr] lg:gap-16">
		<div>
			<h1 class="text-[clamp(3.25rem,13vw,6.5rem)] leading-none font-semibold">Sonear</h1>
			<p class="mt-6 max-w-lg text-lg text-muted sm:text-xl">{dict.lead}</p>

			<div class="mt-8 flex flex-wrap gap-3">
				<a href={latest.downloadUrl} class:list={[buttonBase, "bg-accent text-on-accent hover:bg-accent-hover"]}>{dict.download}</a>
				<a href="https://github.com/HypoxStudios/sonear" class:list={[buttonBase, "border border-line bg-surface hover:bg-raised"]}>{dict.source}</a>
			</div>

			<p class="mt-4 text-sm text-muted">{facts}</p>
			<p class="copy mt-2 text-sm text-muted" set:html={dict.firstTime.replace("{setup}", setup)} />
		</div>

		<div>
			<NowPlaying />
			<p class="mt-3 text-sm text-faint">{dict.colorCaption}</p>
		</div>
	</section>

	<section class="mx-auto max-w-[1100px] px-4 sm:px-6">
		<figure class="reveal rounded-panel border border-line bg-surface p-2 sm:p-3">
			<img
				src={demo.src}
				width={demo.width}
				height={demo.height}
				alt={dict.demoAlt}
				class="h-auto w-full rounded-card"
			/>
			<figcaption class="px-2 pt-3 pb-1 text-sm text-faint sm:px-1">{dict.demoCaption}</figcaption>
		</figure>
	</section>

	<section id="features" class="mx-auto mt-28 max-w-[1100px] px-4 sm:px-6">
		<h2 class="text-3xl sm:text-4xl">{dict.featuresTitle}</h2>

		<div class="mt-12 space-y-16 sm:space-y-24">
			{rows.map((row) => (
				<div class="grid items-center gap-8 md:grid-cols-2 md:gap-16 md:even:[&>*:first-child]:order-2">
					<div>
						<h3 class="text-2xl font-semibold sm:text-3xl">{row.title}</h3>
						<p class="copy mt-4 max-w-md text-lg text-muted" set:html={row.body} />
					</div>
					<div>
						{row.kind === "palette" && <div class="h-[403px]"><Palette labels={dict.palette} /></div>}
						{row.kind === "lyrics" && <Lyrics lines={dict.lyricsLines} />}
						{row.kind === "mini" && <MiniPlayer labels={dict.miniPlayer} />}
						<p class="mt-3 text-sm text-faint">{row.hint}</p>
					</div>
				</div>
			))}
		</div>
	</section>

	<section class="mx-auto mt-28 max-w-[1100px] px-4 sm:px-6">
		<h2 class="text-3xl sm:text-4xl">{dict.littleTitle}</h2>
		<ul class="mt-8 grid gap-x-16 sm:grid-cols-2">
			{dict.little.map((item) => (
				<li class="border-t border-line py-4 text-lg text-muted">{item}</li>
			))}
		</ul>
	</section>

	<section class="mx-auto mt-28 max-w-[1100px] px-4 sm:px-6">
		<h2 class="max-w-2xl text-3xl sm:text-4xl">{dict.perfTitle}</h2>
		<p class="mt-8 max-w-3xl text-xl leading-relaxed text-muted sm:text-2xl sm:leading-relaxed" set:html={perfLead} />

		<dl class="mt-10 max-w-3xl">
			{dict.perf.map((row) => (
				<div class="grid gap-x-8 border-t border-line py-3 sm:grid-cols-2">
					<dt class="text-muted">{row.state}</dt>
					<dd class="tabular-nums">{dict.perfRow.replace("{cpu}", row.cpu).replace("{memory}", row.memory)}</dd>
				</div>
			))}
		</dl>
		<p class="mt-6 max-w-3xl text-sm text-faint">{dict.perfNote}</p>
	</section>

	<section class="mx-auto mt-28 max-w-[1100px] px-4 sm:px-6">
		<h2 class="text-3xl sm:text-4xl">{dict.faqTitle}</h2>
		<div class="mt-8 max-w-3xl divide-y divide-line border-y border-line">
			{dict.faq.map((item) => (
				<details class="py-1">
					<summary class="flex items-center justify-between gap-4 py-4 text-lg font-semibold">{item.q}</summary>
					<div class="copy space-y-3 pb-5 text-muted">
						{item.a.map((block) => <div set:html={block.replaceAll("{privacy}", privacy)} />)}
					</div>
				</details>
			))}
		</div>
	</section>

	<section class="mx-auto mt-28 max-w-[1100px] px-4 sm:px-6">
		<div class="rounded-panel border border-line bg-surface px-6 py-12 text-center sm:py-16">
			<h2 class="text-3xl sm:text-4xl">{dict.closingTitle}</h2>
			<p class="mt-6">
				<a href={latest.downloadUrl} class:list={[buttonBase, "inline-block bg-accent text-on-accent hover:bg-accent-hover"]}>{dict.download}</a>
			</p>
			<p class="mt-4 text-sm text-muted">{facts}</p>
		</div>
	</section>

	<script>
		import "../../scripts/player";
	</script>
</Base>

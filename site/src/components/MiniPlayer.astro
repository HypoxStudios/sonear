---
import { Image } from "astro:assets";
import { tracks } from "../data/now-playing";

interface Props {
	labels: {
		label: string;
		prev: string;
		play: string;
		pause: string;
		next: string;
	};
}

const { labels } = Astro.props;

const button =
	"grid flex-none place-items-center rounded-full transition-colors duration-150 active:scale-95";
---
<div id="mini-player" class="relative h-[260px] overflow-hidden rounded-panel border border-line bg-surface" data-stage>
	<div
		class="mini overflow-hidden rounded-card border border-line bg-raised focus-visible:outline-offset-2"
		tabindex="0"
		role="group"
		aria-label={labels.label}
		data-mini
		data-label-play={labels.play}
		data-label-pause={labels.pause}
	>
		<div class="flex h-full items-center gap-3 p-3">
			<div class="relative size-[72px] flex-none overflow-hidden rounded-[8px] bg-surface">
				{tracks.map((track, i) => (
					<Image src={track.cover} alt="" widths={[144, 216]} sizes="72px" format="webp" draggable="false" class="np-slide absolute inset-0 size-full object-cover" data-i={i} />
				))}
			</div>

			<div class="grid min-w-0 flex-1">
				{tracks.map((track, i) => (
					<div class="np-slide col-start-1 row-start-1 min-w-0" data-i={i}>
						<p class="truncate text-sm font-semibold">{track.title}</p>
						<p class="truncate text-xs text-muted">{track.artist}</p>
					</div>
				))}
			</div>

			<div class="flex flex-none items-center gap-0.5">
				<button type="button" class:list={[button, "size-7 text-muted hover:text-ink"]} aria-label={labels.prev} data-action="prev">
					<svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><g transform="matrix(-1 0 0 1 24 0)"><path d="M5 5.2c0-1.1 1.2-1.7 2.1-1.1l9 6.8c.8.6.8 1.8 0 2.4l-9 6.8c-.9.6-2.1 0-2.1-1.1z" /><rect x="17.5" y="4.5" width="2.5" height="15" rx="1.25" /></g></svg>
				</button>
				<button type="button" class:list={[button, "size-9 bg-accent text-on-accent hover:bg-accent-hover"]} aria-label={labels.play} aria-pressed="false" data-action="toggle">
					<svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor" aria-hidden="true">
						<path class="icon-play" d="M6 4.8c0-1.3 1.4-2.1 2.5-1.4l11.6 7.2c1 .6 1 2.1 0 2.8L8.5 20.6c-1.1.7-2.5-.1-2.5-1.4z" />
						<g class="icon-pause"><rect x="5" y="3.5" width="5" height="17" rx="1.6" /><rect x="14" y="3.5" width="5" height="17" rx="1.6" /></g>
					</svg>
				</button>
				<button type="button" class:list={[button, "size-7 text-muted hover:text-ink"]} aria-label={labels.next} data-action="next">
					<svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor" aria-hidden="true"><path d="M5 5.2c0-1.1 1.2-1.7 2.1-1.1l9 6.8c.8.6.8 1.8 0 2.4l-9 6.8c-.9.6-2.1 0-2.1-1.1z" /><rect x="17.5" y="4.5" width="2.5" height="15" rx="1.25" /></svg>
				</button>
			</div>
		</div>

		<div class="absolute inset-x-0 bottom-0 h-0.5 bg-surface">
			{tracks.map((_, i) => (
				<div class="np-fill absolute inset-0 bg-accent" data-i={i}></div>
			))}
		</div>
	</div>
</div>

<script>
	import "../scripts/mini-player";
</script>
